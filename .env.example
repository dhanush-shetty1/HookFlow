# HookFlow Environment Variables

# Server Port (Default: 4000)
PORT=4000

# MongoDB Atlas Connection URI for Cloud Persistence & Multi-Tenant Dual-Plane Storage
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/hookflow?retryWrites=true&w=majority

# JWT Secret for Authenticated Private Studio Sessions
# JWT_SECRET=your_secure_random_jwt_secret_key_here

# Optional Google Gemini API Key for enhanced AI Schema Synthesis and Anomaly Insights
# GEMINI_API_KEY=AIzaSy...
